NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/shoe-store
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
PAYSTACK_SECRET_KEY=sk_test_local_simulated
PAYSTACK_PUBLIC_KEY=pk_test_replace-with-your-public-key
PENDING_PAYMENT_EXPIRATION_MINUTES=30

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Shoe Store <no-reply@shoestore.test>

# Optional settings read by server/src/scripts/e2e-smoke.js
E2E_API_URL=http://127.0.0.1:5000/api
ADMIN_TOKEN=replace-with-an-admin-jwt
OWNER_TOKEN=replace-with-an-owner-jwt
